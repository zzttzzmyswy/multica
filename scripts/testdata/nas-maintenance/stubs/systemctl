#!/usr/bin/env bash
# Stub `systemctl` for scripts/nas-maintenance.test.sh.
#
# Unit states live under $TB/state/units/*.state, every call is appended to
# $TB/state/calls.log, and nothing real is touched. Failure and transitional
# behaviour is injected through files under $TB/state/opt so a case can pin one
# exact branch without environment plumbing.
set -u

S=${TB:?TB must point at the case directory}/state
mkdir -p "$S/units" "$S/opt"
printf 'systemctl %s\n' "$*" >>"$S/calls.log"

# opt <name>: prints the recorded value, or nothing. Fails when unset.
opt() {
    [ -f "$S/opt/$1" ] || return 1
    cat "$S/opt/$1"
}

state_of() {
    if [ -f "$S/units/$1.state" ]; then cat "$S/units/$1.state"; else printf 'inactive\n'; fi
}

set_state() { printf '%s\n' "$2" >"$S/units/$1.state"; }

case ${1:-} in
    is-active)
        state_of "${2:-}"
        ;;
    stop)
        unit=${2:-}
        # A failing stop leaves the unit untouched: the caller must read the
        # state back rather than trust the exit status.
        if [ "$unit" = "$(opt stop-fail-unit)" ]; then
            exit 1
        fi
        # A stop that reports success but leaves the unit mid-transition.
        if [ "$unit" = "$(opt stop-transition-unit)" ]; then
            set_state "$unit" deactivating
            exit 0
        fi
        # A stop that reports success and changes nothing.
        if [ "$unit" = "$(opt stop-ignore-unit)" ]; then
            exit 0
        fi
        set_state "$unit" inactive
        ;;
    start)
        unit=${2:-}
        if [ "$unit" = "$(opt start-fail-unit)" ]; then
            exit 1
        fi
        # A start that reports success but leaves the unit down.
        if [ "$unit" = "$(opt start-ignore-unit)" ]; then
            exit 0
        fi
        set_state "$unit" active
        ;;
    show)
        # show -p ExecStart --value <unit>
        unit=${!#}
        if printf '%s\n' "$(opt execstart-units)" | tr ' ' '\n' | grep -qx -- "$unit"; then
            printf '{ path=/usr/local/bin/some-other-updater ; argv[]=/usr/local/bin/some-other-updater }\n'
        else
            path=$(opt execstart)
            printf '{ path=%s ; argv[]=%s }\n' "$path" "$path"
        fi
        ;;
    *)
        exit 1
        ;;
esac
