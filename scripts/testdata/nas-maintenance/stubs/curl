#!/usr/bin/env bash
# Stub `curl` for scripts/nas-maintenance.test.sh.
#
# Answers two probes and nothing else:
#   * the backend `/health`, derived from the image the fake backend is running
#     (so a wrong digest cannot also report the expected commit);
#   * the frontend URL, which answers whatever status $TB/state/opt records.
# No case reaches a network.
set -u

S=${TB:?TB must point at the case directory}/state
mkdir -p "$S/opt"
printf 'curl %s\n' "$*" >>"$S/calls.log"

opt() {
    [ -f "$S/opt/$1" ] || return 1
    cat "$S/opt/$1"
}

# The output-format flag is only used by the frontend status probe.
want_code=0
for a in "$@"; do
    case $a in
        *'%{http_code}'*) want_code=1 ;;
    esac
done

case $* in
    *"/health"*)
        [ -f "$S/opt/health-never" ] && exit 22
        running=$(cat "$S/containers/multica-backend-1.running" 2>/dev/null || printf 'false')
        [ "$running" = "true" ] || exit 22
        if [ -f "$S/opt/health-commit" ]; then
            commit=$(opt health-commit)
        else
            image=$(cat "$S/containers/multica-backend-1.image" 2>/dev/null)
            case $image in
                *@sha256:01e09bc9d800260b89834c6a0a00433a456daa5f8ec06211a1515da103817702)
                    commit=8098fd32808c57d8e3b6bd8f7408e6e47b81e7ab
                    ;;
                *@sha256:864a97102959895b174f4fb1e2798bc38c896ea9ff33497564ec11eac5728374)
                    commit=b1ea927def6490c43bedff537b6f4ed9a47fa828
                    ;;
                *)
                    commit=""
                    ;;
            esac
        fi
        if [ -z "$commit" ]; then
            printf '{"status":"ok","pid":4242}\n'
            exit 0
        fi
        printf '{"status":"ok","pid":4242,"commit":"%s","started_at":"2026-01-01T00:00:00Z"}\n' "$commit"
        exit 0
        ;;
esac

# Anything that is not /health is the frontend probe.
code=$(opt frontend-code || printf '200')
if [ -f "$S/opt/frontend-never" ]; then
    # Not listening at all: curl reports a connection failure, no status code.
    exit 7
fi
if [ "$want_code" = 1 ]; then
    printf '%s' "$code"
    exit 0
fi
if [ "$code" -ge 400 ]; then
    exit 22
fi
printf '<!doctype html><title>multica</title>\n'
exit 0
