#!/usr/bin/env bash
# Stub `docker` for scripts/nas-maintenance.test.sh.
#
# Per-container status/image/image-ID files, the local image table, the migration
# ledger and the shape counters all live under $TB/state; every call is appended
# to calls.log so a case can assert call order (stop before dump, no restore
# against the live database). Case-specific behaviour comes from files under
# $TB/state/opt. Nothing here talks to a real daemon.
set -u

S=${TB:?TB must point at the case directory}/state
mkdir -p "$S/containers" "$S/opt" "$S/images"
printf 'docker %s\n' "$*" >>"$S/calls.log"

# opt <name>: prints the recorded value, or nothing. Fails when unset so a
# caller can write `$(opt name || printf '0')`.
opt() {
    [ -f "$S/opt/$1" ] || return 1
    cat "$S/opt/$1"
}

# compose_images <file>: prints "<service> <image>" per service under
# `services:`, honouring each service key's indentation.
compose_images() {
    awk '
        function indent(line,   copy) {
            copy = line
            sub(/[^ ].*/, "", copy)
            return length(copy)
        }
        /^[[:space:]]*#/ { next }
        /^services:[[:space:]]*$/ { in_services = 1; svc_indent = -1; next }
        !in_services { next }
        /^[[:space:]]*$/ { next }
        {
            if (indent($0) == 0) { in_services = 0; next }
            if (svc_indent < 0 && $0 ~ /^[[:space:]]+[A-Za-z0-9_.-]+:[[:space:]]*$/) {
                svc_indent = indent($0)
            }
            if (svc_indent >= 0 && indent($0) == svc_indent && $0 ~ /:[[:space:]]*$/) {
                svc = $0
                sub(/^[[:space:]]+/, "", svc)
                sub(/:.*/, "", svc)
                next
            }
            if (svc != "" && indent($0) > svc_indent && $0 ~ /^[[:space:]]+image:[[:space:]]*/) {
                line = $0
                sub(/^[[:space:]]+image:[[:space:]]*/, "", line)
                sub(/[[:space:]]+#.*/, "", line)
                print svc " " line
            }
        }
    ' "$1"
}

image_for_service() {
    compose_images "$1" | awk -v want="$2" '$1 == want { print $2 }'
}

name_of() {
    case $1 in
        backend) printf 'multica-backend-1\n' ;;
        frontend) printf 'multica-frontend-1\n' ;;
        *) printf '%s\n' "$1" ;;
    esac
}

write_container() {
    printf '%s\n' "$2" >"$S/containers/$1.image"
    printf '%s\n' "$3" >"$S/containers/$1.status"
    printf '%s\n' "$4" >"$S/containers/$1.running"
    # A container's image ID follows the image it was started from, the way a
    # real daemon records it.
    printf '%s\n' "$(image_id_of_ref "$2")" >"$S/containers/$1.image_id"
}

read_container() {
    [ -f "$S/containers/$1.$2" ] && cat "$S/containers/$1.$2"
    return 0
}

counter() {
    if [ -f "$S/$1" ]; then cat "$S/$1"; else printf '%s\n' "$2"; fi
}

# image_id_of_ref <ref>: a stable synthetic ID. The same ref (tag or digest) on
# the same host yields the same ID, and the image table records which digests
# that ID carries, mirroring `docker image inspect .RepoDigests`.
image_id_of_ref() {
    printf 'image-id-%s\n' "$(printf '%s' "$1" | cksum | awk '{print $1}')"
}

# repo_digests_of <ref>: consult $S/images/<id>.digests, which the case fixture
# writes. A tag resolves to whatever digests the fixture recorded for it. A ref
# that is already an image ID (as `docker inspect .Image` returns) is looked up
# directly, the way a real daemon accepts either form.
repo_digests_of() {
    local ref=$1 id
    if [ -f "$S/images/$ref.digests" ]; then
        cat "$S/images/$ref.digests"
        return 0
    fi
    id=$(image_id_of_ref "$ref")
    [ -f "$S/images/$id.digests" ] && cat "$S/images/$id.digests"
    return 0
}

query() {
    case $1 in
        *"max(version)"*) counter ledger 616_member_pinned ;;
        *"count(*) from schema_migrations"*) counter ledger_rows 640 ;;
        *"information_schema.tables"*) counter tables 131 ;;
        *"from pg_index"*) counter indexes 740/0/0 ;;
        *) printf '\n' ;;
    esac
}

case ${1:-} in
    image)
        # image inspect [-f <format>] <ref>
        fmt=""
        if [ "${3:-}" = "-f" ]; then
            fmt=${4:-}
        fi
        ref=${!#}
        case $fmt in
            *RepoDigests*)
                repo_digests_of "$ref"
                ;;
            *Id*)
                for miss in $(opt missing-images || true); do
                    case $ref in
                        *"$miss"*) printf 'Error: No such image: %s\n' "$ref" >&2; exit 1 ;;
                    esac
                done
                image_id_of_ref "$ref"
                ;;
            *)
                for miss in $(opt missing-images || true); do
                    case $ref in
                        *"$miss"*) printf 'Error: No such image: %s\n' "$ref" >&2; exit 1 ;;
                    esac
                done
                image_id_of_ref "$ref"
                ;;
        esac
        ;;
    inspect)
        fmt=${3:-}
        name=${4:-}
        case $fmt in
            *State.Status*) read_container "$name" status ;;
            *State.Running*) read_container "$name" running ;;
            *Config.Image*) read_container "$name" image ;;
            *"{{.Image}}"*) read_container "$name" image_id ;;
            *Config.Env*)
                printf 'PATH=/usr/bin\nDATABASE_URL=postgres://multica:secret@pg:5432/multica?sslmode=disable\n'
                ;;
            *) printf '{}\n' ;;
        esac
        ;;
    exec)
        shift
        interactive=0
        if [ "${1:-}" = "-i" ]; then interactive=1; shift; fi
        container=${1:-}
        shift || true
        printf 'exec %s %s\n' "$container" "$*" >>"$S/exec.log"
        case ${1:-} in
            psql) query "$*" ;;
            pg_dump)
                printf 'PGDMP'
                i=0
                while [ "$i" -lt 200 ]; do
                    printf ' stub-dump-%04d' "$i"
                    i=$((i + 1))
                done
                printf '\n'
                exit "$(opt dump-rc || printf '0')"
                ;;
            pg_restore)
                case $* in
                    *" -l"*)
                        [ "$interactive" = 1 ] && cat >/dev/null
                        printf ';\n; Archive created at stub\n'
                        i=0
                        lines=$(opt toc-lines || printf '500')
                        while [ "$i" -lt "$lines" ]; do
                            printf '%d; 1259 %d TABLE public stub_%d postgres\n' \
                                "$((i + 1))" "$((100 + i))" "$i"
                            i=$((i + 1))
                        done
                        exit "$(opt toc-rc || printf '0')"
                        ;;
                    *)
                        # Restoring into the live database must never happen.
                        printf 'RESTORE-CALLED %s\n' "$*" >>"$S/restore.log"
                        exit "$(opt restore-rc || printf '0')"
                        ;;
                esac
                ;;
            *) exit 0 ;;
        esac
        ;;
    run)
        printf 'run %s\n' "$*" >>"$S/migrate.log"
        if [ "$(opt migrate-rc || printf '0')" = 0 ]; then
            printf '%s\n' "$(opt ledger-after || printf '660_attachment_upload_session_workspace')" >"$S/ledger"
            printf '%s\n' "$(opt rows-after || printf '684')" >"$S/ledger_rows"
            printf '%s\n' "$(opt tables-after || printf '148')" >"$S/tables"
            printf '%s\n' "$(opt indexes-after || printf '799/0/0')" >"$S/indexes"
        elif [ -n "$(opt partial-ledger)" ]; then
            printf '%s\n' "$(opt partial-ledger)" >"$S/ledger"
            printf '%s\n' "$(opt partial-rows || printf '670')" >"$S/ledger_rows"
        fi
        exit "$(opt migrate-rc || printf '0')"
        ;;
    compose)
        shift
        file=""
        while [ $# -gt 0 ]; do
            case $1 in
                -f) file=$2; shift 2 ;;
                -p) shift 2 ;;
                *) break ;;
            esac
        done
        action=${1:-}
        shift || true
        printf 'compose %s %s %s\n' "$file" "$action" "$*" >>"$S/compose.log"
        case $action in
            stop)
                for svc in "$@"; do
                    name=$(name_of "$svc")
                    [ "$name" = "$(opt stop-ignore-container)" ] && continue
                    write_container "$name" "$(read_container "$name" image)" exited false
                done
                exit "$(opt compose-stop-rc || printf '0')"
                ;;
            up)
                rc=$(opt compose-rc || printf '0')
                [ "$rc" = 0 ] || exit "$rc"
                for svc in "$@"; do
                    name=$(name_of "$svc")
                    img=$(image_for_service "$file" "$svc")
                    [ -n "$img" ] || continue
                    # A daemon that brings the container up on another image (a
                    # stale tag, a silently reused container).
                    override=$(opt "up-image-$svc" || true)
                    [ -n "$override" ] && img=$override
                    # A frontend that starts but never serves its port.
                    if [ "$svc" = frontend ] && [ -f "$S/opt/frontend-down" ]; then
                        write_container "$name" "$img" running true
                        continue
                    fi
                    write_container "$name" "$img" running true
                done
                exit 0
                ;;
            *) exit 0 ;;
        esac
        ;;
    logs)
        printf 'stub backend log line\n'
        ;;
    *) exit 0 ;;
esac
